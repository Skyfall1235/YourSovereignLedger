@using YourSovereignLedger.Core
<tr>
    <!-- CLIENT COLUMN -->
    <td>
        @* TODO: Replace raw text with <PrivacyMask Value="@CustomerName" /> later *@
        <PrivacyMask Value="@CustomerName"/>
    </td>

    <!-- STATUS COLUMN -->
    <td>
        <StatusBadge Status="@Status"></StatusBadge>
    </td>

    <!-- PROGRESS COLUMN -->
    <td>
        <div>
            <progress value="@ProgressPercentage" max="100"></progress>
            <span>@ProgressPercentage%</span>
        </div>
    </td>

    <!-- FEE COLUMN (Paid) -->
    <td>
        @Fee.ToString("C")
    </td>

    <!-- DUE COLUMN (Remaining Balance) -->
    <td>
        @Due.ToString("C")
    </td>
</tr>

@code {
    [Parameter] public string CustomerName { get; set; } = string.Empty;
    [Parameter] public OrderEnums.Status Status { get; set; }
    public int ProgressPercentage => (int)Status * 20;
    [Parameter] public decimal Fee { get; set; }
    [Parameter] public decimal Due { get; set; }
}